<?xml version="1.0"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="tvutils"
	SccProjectName=""
	SccLocalPath="">
	<Build>
		<Settings>
			<Platform
				Name="Win32"/>
			<Configuration
				Name="Release|Win32"
				IntermediateDirectory=".\Release"
				OutputDirectory=".\Release"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE"
				CharacterSet="2">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Release/tvutils.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					InlineFunctionExpansion="1"
					IncludePaths="$(pathtv),$(pathtv)/winbuild,$(pathtv)/tsm,$(pathtv)/tsm/winbuild,$(pathtv)/tsm/winbuild/tsm,$(pathtv)/bin/WIN954.0_DBG.OBJ/include,$(pathtv)/tiff/libtiff,$(pathtv)/libXML,$(pathtv)/libXML/winbuild,$(pathtv)/jpeg,$(pathtv)/jpeg/winbuild,$(pathtv)/libungif/lib"
					Defines="WIN32,NDEBUG,_LIB"
					StringPooling="TRUE"
					RuntimeLibrary="2"
					PackageFunctions="TRUE"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Release/tvutils.pch"
					AsmListingLocation=".\Release/"
					ObjectFile=".\Release/"
					ProgramDataBaseFileName=".\Release/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\tvutils.lib&quot;&quot; "
					OutputFile=".\Release\tvutils.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="NDEBUG"
					Culture="1033"/>
			</Configuration>
			<Configuration
				Name="Debug|Win32"
				IntermediateDirectory=".\Debug"
				OutputDirectory=".\Debug"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Debug/tvutils.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					Optimization="0"
					IncludePaths="$(pathtv);$(pathtv)/winbuild;$(pathtv)/tsm;$(pathtv)/tsm/winbuild;$(pathtv)/tsm/winbuild/tsm;$(pathtv)/bin/WIN954.0_DBG.OBJ/include;$(pathtv)/tiff/libtiff;$(pathtv)/libXML;$(pathtv)/libXML/winbuild;$(pathtv)/jpeg;$(pathtv)/jpeg/winbuild;$(pathtv)/libungif/lib"
					Defines="WIN32,_DEBUG,_WINDOWS,HAVE_CONFIG_H"
					RuntimeLibrary="3"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Debug/tvutils.pch"
					AsmListingLocation=".\Debug/"
					ObjectFile=".\Debug/"
					ProgramDataBaseFileName=".\Debug/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"
					DebugInformation="1"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\tvutils_d.lib&quot;&quot; "
					OutputFile="$(pathtv)/bin/tvutils_d.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="_DEBUG"
					Culture="1033"/>
			</Configuration>
		</Settings>
	</Build>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;rc;def;r;odl;idl;hpj;bat">
			<File
				RelativePath="..\Args.c">
			</File>
			<File
				RelativePath="..\Config.c">
			</File>
			<File
				RelativePath="..\Graphics.c">
			</File>
			<File
				RelativePath="..\Init.c">
			</File>
			<File
				RelativePath="..\Values.c">
			</File>
			<File
				RelativePath="..\Viewpoint.c">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath="..\acconfig.h">
			</File>
			<File
				RelativePath="..\Args.h">
			</File>
			<File
				RelativePath="..\Config.h">
			</File>
			<File
				RelativePath="..\Init.h">
			</File>
			<File
				RelativePath="..\Platform.h">
			</File>
			<File
				RelativePath="..\tvutils.h">
			</File>
			<File
				RelativePath="..\Viewpoint.h">
			</File>
		</Filter>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
