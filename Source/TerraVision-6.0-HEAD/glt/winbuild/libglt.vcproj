<?xml version="1.0"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="libglt"
	SccProjectName=""
	SccLocalPath="">
	<Build>
		<Settings>
			<Platform
				Name="Win32"/>
			<Configuration
				Name="Debug|Win32"
				IntermediateDirectory=".\Debug"
				OutputDirectory=".\Debug"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Debug/libglt.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					Optimization="0"
					IncludePaths="$(pathtv),$(pathtv)/winbuild,$(pathtv)/bin/WIN954.0_DBG.OBJ/include"
					Defines="WIN32,_DEBUG,_WINDOWS,HAVE_CONFIG_H"
					RuntimeLibrary="3"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Debug/libglt.pch"
					AsmListingLocation=".\Debug/"
					ObjectFile=".\Debug/"
					ProgramDataBaseFileName=".\Debug/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"
					DebugInformation="1"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\libglt_d.lib&quot;&quot; "
					OutputFile="$(pathtv)/bin/libglt_d.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="_DEBUG"
					Culture="1033"/>
			</Configuration>
			<Configuration
				Name="Release|Win32"
				IntermediateDirectory=".\Release"
				OutputDirectory=".\Release"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE"
				CharacterSet="2">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Release/libglt.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					InlineFunctionExpansion="1"
					IncludePaths="$(pathtv),$(pathtv)/winbuild,$(pathtv)/bin/WIN954.0_DBG.OBJ/include"
					Defines="WIN32,NDEBUG,_LIB,HAVE_CONFIG_H"
					StringPooling="TRUE"
					RuntimeLibrary="2"
					PackageFunctions="TRUE"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Release/libglt.pch"
					AsmListingLocation=".\Release/"
					ObjectFile=".\Release/"
					ProgramDataBaseFileName=".\Release/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\libglt.lib&quot;&quot; "
					OutputFile=".\Release\libglt.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="NDEBUG"
					Culture="1033"/>
			</Configuration>
		</Settings>
	</Build>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;rc;def;r;odl;idl;hpj;bat">
			<File
				RelativePath="..\glm.c">
			</File>
			<File
				RelativePath="..\glmil.c">
			</File>
			<File
				RelativePath="..\glmWin.c">
			</File>
			<File
				RelativePath="..\glt.c">
			</File>
			<File
				RelativePath="..\glt_inline.c">
			</File>
			<File
				RelativePath="..\glt_state.c">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath="..\glm.h">
			</File>
			<File
				RelativePath="..\glmil.h">
			</File>
			<File
				RelativePath="..\glmimpl.h">
			</File>
			<File
				RelativePath="..\glt.h">
			</File>
			<File
				RelativePath="..\glt_inline.h">
			</File>
			<File
				RelativePath="..\gltI.h">
			</File>
		</Filter>
		<File
			RelativePath="..\ChangeLog">
		</File>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
