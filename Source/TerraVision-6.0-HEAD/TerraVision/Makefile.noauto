CC	    = cc -fullwarn

MODULE      = TerraVision
SOURCE.cxx  = 
SOURCE.C    = $(SOURCE.cxx:.cxx=.C)
SOURCE.c    = AboutDialog.c Clock.c Dialogs.c DrawModel.c \
	      TsmWidget.c Gats.c GATSDialogs.c Model.c ModelAnim.c \
	      ScannedMap.c \
              TerraVision.c TerraVisionAvs.c TerraVisionCAVE.c \
	      Texture.c ThreeDControl.c ThreeDPanel.c \
	      ThreeDWidget.c ThreeDWidget1.c TileManager.c \
	      TileRequester.c TwoDWidget.c \
              Visible.c RequestGenerator.c X11FrameGrab.c \
	      matrix.c pixmaps.c xpmhash.c xpmread.c xcolor.c xv24to8.c \
	      # SpaceBall.c

SRCDIR 	    = ..

include $(SRCDIR)/etc/make.cfg

TRACE_FLAG  = -DPTHR_TRACING

INCLUDE     = -I$(SRCDIR)/cave/include -I$(SRCDIR)/include -Ibitmaps \
	      $(ISS_INC) -I$(SRCDIR)/include/tsm
CFLAGS      = -D_SGI_MP_SOURCE -DGATS ${ISS_CFLAG} $(TRACE_FLAG)
LDFLAGS     = -L$(SRCDIR)/cave/lib -L$(SRCDIR)/lib ${ISS_LDFLAG} \
      -L$(SRCDIR)/mips-sgi-irix5/lib

# Unnecessary libraries:
#             -lcave -limage -lspaceball -lspkm -lcrypto -lssh -lgmp \

LIBRARY     = -lGats -lTileSvc -lMagic -lList -lreport -lpthread \
	      -l$(TSM_LIBNAME) -lrtp -lwww -lvideo \
	      -lgutil -limage -lglt -lGLw -lGL -lGLU -lXm -lXt -lX11 \
	      -lspaceball -lfastm -lm -lcginm -lm \
	      $(ISS_LIBS)

LIBHOME     = ../lib
LIBS        = $(LIBHOME)/libMagic.a \
	      $(LIBHOME)/libTileSvc.a \
	      $(LIBHOME)/libGats.a

CC       = cc -xansi
G_CFLAGS = -DXTFUNCPROTO -DFUNCPROTO
OPTFLAGS = -g

CC       = gcc -mcpu=r4000
G_CFLAGS = -DXTFUNCPROTO -DFUNCPROTO \
	-Wall -Wformat -Wno-unused -Wreturn-type -Wmissing-prototypes
OPTFLAGS = -g -O2

# ---------------------------------------------------

all debug optimize: $(MODULE)

$(MODULE): $(OBJECTS) $(LIBS)
	$(CC) $(OPTFLAGS) $(G_LDFLAGS) $(LDFLAGS) $(OBJECTS) $(LIBRARY) -o $(MODULE)

$(MODULE).pure: $(OBJECTS) $(LIBS)
	purify $(CC) $(OPTFLAGS) $(G_LDFLAGS) $(LDFLAGS) $(OBJECTS) $(LIBRARY) -o $(MODULE).pure

depend:
	$(MAKEDEPEND) $(INCLUDE) $(MDFLAGS) $(SOURCE)

lint:
	$(LINT) $(LINTFLAGS) $(SOURCE)

clean:
	$(RM) *.bak *.def.cxx *.def.c *.ixx *.i
	$(CLEAN_O)

realclean:
	$(RM) *.bak *.def.cxx *.def.c *.ixx *.i *.o

# For testing

test_opengl: test_opengl.o ppm.o
	$(CC) $(OPTFLAGS) $(G_LDFLAGS) $(LDFLAGS) test_opengl.o ppm.o -o test_opengl\
	  -lGLw -lGLU -lGL -lXm -lXt -lX11

test_opengl.o: test_opengl.c test_opengl.ad.h

tresize: tresize.o
	$(CC) $(OPTFLAGS) $(G_LDFLAGS) $(LDFLAGS) -o tresize \
	   tresize.o gl_utils.o -lMagic -lgthread -lgutil -limage \
	   -lglut -lGLU -lGL -lXt -lXmu -lX11

%.ad.h: %.ad
	ad2c < $< > $@


