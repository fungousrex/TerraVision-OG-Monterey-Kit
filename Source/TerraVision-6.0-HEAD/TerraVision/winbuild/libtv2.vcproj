<?xml version="1.0"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="libtv2"
	SccProjectName=""
	SccLocalPath="">
	<Build>
		<Settings>
			<Platform
				Name="Win32"/>
			<Configuration
				Name="Release|Win32"
				IntermediateDirectory=".\Release"
				OutputDirectory=".\Release"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE"
				CharacterSet="2">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Release/libtv2.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					InlineFunctionExpansion="1"
					IncludePaths="$(pathtv),$(pathtv)/winbuild,$(pathtv)/tsm,$(pathtv)/tsm/winbuild,$(pathtv)/tsm/winbuild/tsm,$(pathtv)/bin/WIN954.0_DBG.OBJ/include,$(pathtv)/conversions,$(pathtv)/terravision"
					Defines="WIN32,NDEBUG,_LIB,HAVE_CONFIG_H"
					StringPooling="TRUE"
					RuntimeLibrary="2"
					PackageFunctions="TRUE"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Release/libtv2.pch"
					AsmListingLocation=".\Release/"
					ObjectFile=".\Release/"
					ProgramDataBaseFileName=".\Release/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\libtv2.lib&quot;&quot; "
					OutputFile="$(pathtv)/bin/libtv2.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="NDEBUG"
					Culture="1033"/>
			</Configuration>
			<Configuration
				Name="Debug|Win32"
				IntermediateDirectory=".\Debug"
				OutputDirectory=".\Debug"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Debug/libtv2.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					Optimization="0"
					IncludePaths="$(pathtv),$(pathtv)/winbuild,$(pathtv)/tsm,$(pathtv)/tsm/winbuild,$(pathtv)/tsm/winbuild/tsm,$(pathtv)/bin/WIN954.0_DBG.OBJ/include,$(pathtv)/conversions,$(pathtv)/terravision"
					Defines="WIN32,_DEBUG,_WINDOWS,HAVE_CONFIG_H"
					RuntimeLibrary="3"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Debug/libtv2.pch"
					AsmListingLocation=".\Debug/"
					ObjectFile=".\Debug/"
					ProgramDataBaseFileName=".\Debug/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"
					DebugInformation="1"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\libtv2_d.lib&quot;&quot; "
					OutputFile="$(pathtv)/bin/libtv2_d.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="_DEBUG"
					Culture="1033"/>
			</Configuration>
		</Settings>
	</Build>
	<Files>
		<Filter
