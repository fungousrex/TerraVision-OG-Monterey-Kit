#
# Makefile.noauto - Martin Reddy <reddy@ai.sri.com>,  19 March 1999
#
# This is a quick and dirty Makefile in order to compile up the tiff
# libraries of the libtiff distribution under a Windows environment.
#
# *** THIS FILE IS NOT PART OF THE STANDARD LIBTIFF DISTRIBUTION ***
#
# The configure script does not appear to work under the Nutcraker
# unix environment on WinNT - normally we just regenerate this from the 
# configure.in script with autoconf; however, this file is not
# supplied with the libtiff distribution. Therefore, this Makefile
# was written in order to compile up the libjpeg.a library.
#
# usage:
#    make -f Makefile.noauto [all]     - generate libjpeg.a
#    make -f Makefile.noauto clean     - remove all library & obj files
#    make -f Makefile.noauto install   - currently does nothing
#
# $Id: Makefile.noauto,v 1.1 1999/03/21 23:25:13 reddy Exp $
#

CC        = cc 
INCLUDE   = -I.
CFLAGS    = -DJPEG_SUPPORT -DZIP_SUPPORT -g
NUTCFLAGS =  -W/w -WNC_WIN95 -WNC_LIB_STRICT
LIBRARY   = libjpeg.a
COMPILE    = $(CC) $(INCLUDE) $(CFLAGS) $(NUTCFLAGS)

RM        = rm -f
AR        = ar rc

OBJS = \
	jcapimin.o \
	jcapistd.o \
	jctrans.o \
	jcparam.o \
	jdatadst.o \
	jcinit.o \
	jcmaster.o \
	jcmarker.o \
	jcmainct.o \
	jcprepct.o \
	jccoefct.o \
	jccolor.o \
	jcsample.o \
	jchuff.o \
	jcphuff.o \
	jcdctmgr.o \
	jfdctfst.o \
	jfdctflt.o \
	jfdctint.o \
	jdapimin.o \
	jdapistd.o \
	jdtrans.o \
	jdatasrc.o \
	jdmaster.o \
	jdinput.o \
	jdmarker.o \
	jdhuff.o \
	jdphuff.o \
	jdmainct.o \
	jdcoefct.o \
	jdpostct.o \
	jddctmgr.o \
	jidctfst.o \
	jidctflt.o \
	jidctint.o \
	jidctred.o \
	jdsample.o \
	jdcolor.o \
	jquant1.o \
	jquant2.o \
	jdmerge.o \
	jcomapi.o \
	jutils.o \
	jerror.o \
	jmemmgr.o \
	jmemnobs.o

.c.o:
	$(COMPILE) -c $<

all: $(LIBRARY)

jconfig.h:
	$(RM) ./ckconfig.exe
	$(COMPILE) ckconfig.c -o ckconfig.exe
	./ckconfig.exe

$(LIBRARY): jconfig.h $(OBJS)
	$(RM) $(LIBRARY)
	$(AR) $(LIBRARY) $(OBJS)

clean:
	$(RM) $(OBJS) $(LIBRARY) core

install:
