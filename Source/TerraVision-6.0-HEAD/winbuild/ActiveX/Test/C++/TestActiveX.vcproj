<?xml version="1.0"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="TestActiveX"
	SccProjectName=""
	SccLocalPath="">
	<Build>
		<Settings>
			<Platform
				Name="Win32"/>
			<Configuration
				Name="Debug|Win32"
				IntermediateDirectory=".\Debug"
				OutputDirectory=".\Debug"
				ConfigurationType="1"
				UseOfMFC="2"
				ATLMinimizesCRunTimeLibraryUsage="FALSE"
				CharacterSet="2">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Debug/TestActiveX.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					Optimization="0"
					Defines="WIN32;_DEBUG;_WINDOWS;HAVE_CONFIG_H"
					RuntimeLibrary="3"
					UsePrecompiledHeader="3"
					PrecompiledHeaderThrough="stdafx.h"
					PrecompiledHeaderFile=".\Debug/TestActiveX.pch"
					AsmListingLocation=".\Debug/"
					ObjectFile=".\Debug/"
					ProgramDataBaseFileName=".\Debug/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"
					DebugInformation="1"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLinkerTool"
					AdditionalOptions="/MACHINE:I386"
					OutputFile="$(pathtv)/bin/TestActiveX_d.exe"
					LinkIncremental="1"
					SuppressStartupMessage="TRUE"
					GenerateDebug="TRUE"
					ProgramDatabaseFile=".\Debug/TestActiveX.pdb"
					SubSystem="2"/>
				<Tool
					Name="VCMIDLTool"
					Defines="_DEBUG"
					MkTypLibCompatibility="TRUE"
					SuppressStartupMessage="TRUE"
					TargetEnvironment="1"
					TypeLibraryName=".\Debug/TestActiveX.tlb"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="_AFXDLL;_DEBUG"
					Culture="1033"/>
				<Tool
					Name="VCSDLTool"/>
			</Configuration>
			<Configuration
				Name="Release|Win32"
				IntermediateDirectory=".\Release"
				OutputDirectory=".\Release"
				ConfigurationType="1"
				UseOfMFC="2"
				ATLMinimizesCRunTimeLibraryUsage="FALSE"
				CharacterSet="2">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Release/TestActiveX.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					InlineFunctionExpansion="1"
					Defines="WIN32;NDEBUG;_WINDOWS;HAVE_CONFIG_H"
					StringPooling="TRUE"
					RuntimeLibrary="2"
					PackageFunctions="TRUE"
					UsePrecompiledHeader="3"
					PrecompiledHeaderThrough="stdafx.h"
					PrecompiledHeaderFile=".\Release/TestActiveX.pch"
					AsmListingLocation=".\Release/"
					ObjectFile=".\Release/"
					ProgramDataBaseFileName=".\Release/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLinkerTool"
					AdditionalOptions="/MACHINE:I386"
					OutputFile=".\Release/TestActiveX.exe"
					LinkIncremental="1"
					SuppressStartupMessage="TRUE"
					ProgramDatabaseFile=".\Release/TestActiveX.pdb"
					SubSystem="2"/>
				<Tool
					Name="VCMIDLTool"
					Defines="NDEBUG"
					MkTypLibCompatibility="TRUE"
					SuppressStartupMessage="TRUE"
					TargetEnvironment="1"
					TypeLibraryName=".\Release/TestActiveX.tlb"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="_AFXDLL;NDEBUG"
					Culture="1033"/>
				<Tool
					Name="VCSDLTool"/>
			</Configuration>
		</Settings>
	</Build>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;rc;def;r;odl;idl;hpj;bat">
			<File
				RelativePath=".\MainFrm.cpp">
			</File>
			<File
				RelativePath=".\StdAfx.cpp">
				<FileConfiguration
					Name="Debug|Win32">
					<Tool
						Name="VCCLCompilerTool"
						UsePrecompiledHeader="1"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Release|Win32">
					<Tool
						Name="VCCLCompilerTool"
						UsePrecompiledHeader="1"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\terravision.cpp">
			</File>
			<File
				RelativePath=".\TestActiveX.cpp">
			</File>
			<File
				RelativePath=".\TestActiveX.rc">
			</File>
			<File
				RelativePath=".\TestActiveXDoc.cpp">
			</File>
			<File
				RelativePath=".\TestActiveXView.cpp">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath=".\MainFrm.h">
			</File>
			<File
				RelativePath=".\Resource.h">
			</File>
			<File
				RelativePath=".\StdAfx.h">
			</File>
			<File
				RelativePath=".\terravision.h">
			</File>
			<File
				RelativePath=".\TestActiveX.h">
			</File>
			<File
				RelativePath=".\TestActiveXDoc.h">
			</File>
			<File
				RelativePath=".\TestActiveXView.h">
			</File>
		</Filter>
		<Filter
			Name="Resource Files"
			Filter="ico;cur;bmp;dlg;rc2;rct;bin;rgs;gif;jpg;jpeg;jpe">
			<File
				RelativePath=".\res\TestActiveX.ico">
			</File>
			<File
				RelativePath=".\res\TestActiveX.rc2">
			</File>
			<File
				RelativePath=".\res\TestActiveXDoc.ico">
			</File>
			<File
				RelativePath=".\res\Toolbar.bmp">
			</File>
		</Filter>
		<File
			RelativePath=".\ReadMe.txt">
		</File>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
