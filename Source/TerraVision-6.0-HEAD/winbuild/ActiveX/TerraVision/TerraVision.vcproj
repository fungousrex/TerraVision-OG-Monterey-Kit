echo regsvr32 exec. time &gt; &quot;$(OutDir)\regsvr32.trg&quot;
"
					Outputs="$(OutDir)\regsvr32.trg"/>
				<Tool
					Name="VCLinkerTool"
					AdditionalOptions="/MACHINE:I386"
					AdditionalInputs="opengl32.lib glu32.lib ws2_32.lib mswsock.lib winmm.lib &quot;$(pathdotgeo)/bin/libGeoStatic_DiscClient_d.lib&quot; &quot;$(pathdotgeo)/bin/libGeoStatic_Core_d.lib&quot; &quot;$(pathtv)/bin/libtv2_d.lib&quot; &quot;$(pathtv)/bin/libtsm_d.lib&quot; &quot;$(pathtv)/bin/libghttp_d.lib&quot; &quot;$(pathtv)/bin/libpthr_d.lib&quot; &quot;$(pathtv)/bin/libjpg_d.lib&quot; &quot;$(pathtv)/bin/libtiff_d.lib&quot; &quot;$(pathtv)/bin/libungif_d.lib&quot; &quot;$(pathtv)/bin/libvrml2_d.lib&quot; &quot;$(pathtv)/bin/libglt_d.lib&quot; &quot;$(pathtv)/bin/tvutils_d.lib&quot; &quot;$(pathtv)/bin/libxml_d.lib&quot; &quot;$(pathtv)/bin/libconv_d.lib&quot; &quot;$(pathtv)/bin/libdis_d.lib&quot;"
					OutputFile="$(pathtv)/bin/TerraVision.ocx"
