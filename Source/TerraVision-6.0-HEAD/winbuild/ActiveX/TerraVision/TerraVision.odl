			[id(48)] void setView(double x, double y, double z, double yaw, double pitch, double roll);
			[id(49)] void setViewGDC(double latitude, double longitude, double elevation, double yaw, double pitch, double roll);
			[id(50)] void stopMotion();
			[id(51)] void translate(double x, double y, double z);
			[id(52)] void unloadModel(BSTR url);
			[id(53)] void unloadTerrain(BSTR geoname);
			[id(54)] void host(BSTR host);
