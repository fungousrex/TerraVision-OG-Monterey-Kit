			[id(20)] boolean useZBufferHack;
			[id(21)] boolean freezeTiles;
			[id(22)] boolean showTileDebug;
			[id(23)] boolean scaleIPD;
			[id(24)] boolean useMipMapTextures;
			[id(25)] boolean useBackfaceCull;
			[id(26)] boolean useHeightBasedNavigation;
			[id(27)] boolean use2DConstrain;
