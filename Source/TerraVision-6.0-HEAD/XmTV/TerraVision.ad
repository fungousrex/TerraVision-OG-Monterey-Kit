! These configuration values used to reside in $MAGIC_CONFIG and were
! accessed with getconfig().

! *** N.B. ALL TIMINGS ARE IN UNITS OF MILLISECONDS ***

! Name of a DEBUG set of DEM's
*DEM_PATHNAME: /home/crazy2/magic/TerraVision/ntc-1-utm-2scene/DEM

! ISS Information
*ISS_HOSTNAME: iss-1-atm.sri.magic.net
!*ISS_HOSTNAME: edciss1.cr.usgs.gov

! Timings for the visibility loop.
*VISIBLE_MIN:		10
*VISIBLE_MAX:		50

! Request Rates for OIs
*REQUEST_RATE:		500

! Request Rates for OIs
*READER_RATE:		10

! Request Rates for DEMs
*DEM_REQUEST_RATE:	2000

! DEFAULT URL
!*master_urls: x-dsm://iss-1-atm.sri.magic.net

!
! PATHNAME FOR LOGFILES
!
*LOG_PATHNAME:		/usr/tmp

! 
! These relate to the texture cache for paging stuff into
! and out of texture map memory
!
*TEXTURE_CACHE_SIZE:  	90
*TEXTURE_PATHNAME:	$TVHOME/etc/textures

!
! These keys relate to how big DEM tile tables should be and how many
! will actually be cached in memory.
!
*DEM_CACHE_SIZE:	5000

!
! These keys relate to how big OI tile tables should be.
!
*OI_CACHE_SIZE:		400

!
! MAP IMAGE FOR "ABOUT TERRAVISION"
!
*MAPIMAGE_FILE: 	$TVHOME/etc/about.gif

!
! SYSTEM CLOCK RESOLUTION IN MICRO SECONDS
!
*CLOCK_RESOLUTION_USEC:	500000

!
! MOSAIC URL'S
!
*ARPA_URL:		http://www.darpa.mil/
*MAGIC_URL:		http://www.magic.net/
*SRI_URL:		http://www.sri.com/
*TERRAVISION_URL: 	http://www.ai.sri.com/TerraVision
*SPRINT_URL:  		http://www.sprintlink.net/public/http/welcome.html

!
! EVEN CHEESIER SELECTION FOR WHICH TILE SET AND SERVER COMBO
!
*CAVE_GEO:                0
*CAVE_DEM:                0
*CAVE_DEM_SERVER:         0
*CAVE_MOSAIC:             0
*CAVE_MOSAIC_SERVER:      0

! *** THE VALUES BELOW ARE LARGELY COSMETIC ***
