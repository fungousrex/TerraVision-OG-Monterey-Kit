<?xml version="1.0"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="libpthr"
	SccProjectName=""
	SccLocalPath="">
	<Build>
		<Settings>
			<Platform
				Name="Win32"/>
			<Configuration
				Name="Release|Win32"
				IntermediateDirectory=".\Release"
				OutputDirectory=".\Release"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE"
				CharacterSet="2">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Release/libpthr.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					InlineFunctionExpansion="1"
					IncludePaths="$(pathtv),$(pathtv)/winbuild,$(pathtv)/bin/WIN954.0_DBG.OBJ/include"
					Defines="WIN32,NDEBUG,_LIB,HAVE_CONFIG_H"
					StringPooling="TRUE"
					RuntimeLibrary="2"
					PackageFunctions="TRUE"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Release/libpthr.pch"
					AsmListingLocation=".\Release/"
					ObjectFile=".\Release/"
					ProgramDataBaseFileName=".\Release/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\libpthr.lib&quot;&quot; "
					OutputFile=".\Release\libpthr.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="NDEBUG"
					Culture="1033"/>
			</Configuration>
			<Configuration
				Name="Debug|Win32"
				IntermediateDirectory=".\Debug"
				OutputDirectory=".\Debug"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Debug/libpthr.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					Optimization="0"
					IncludePaths="$(pathtv),$(pathtv)/winbuild,$(pathtv)/bin/WIN954.0_DBG.OBJ/include"
					Defines="WIN32,_DEBUG,_WINDOWS,HAVE_CONFIG_H"
					RuntimeLibrary="3"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Debug/libpthr.pch"
					AsmListingLocation=".\Debug/"
					ObjectFile=".\Debug/"
					ProgramDataBaseFileName=".\Debug/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"
					DebugInformation="1"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\libpthr_d.lib&quot;&quot; "
					OutputFile="$(pathtv)/bin/libpthr_d.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="_DEBUG"
					Culture="1033"/>
			</Configuration>
		</Settings>
	</Build>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;rc;def;r;odl;idl;hpj;bat">
			<File
				RelativePath="..\aqueue.c">
			</File>
			<File
				RelativePath="..\eqhash.c">
			</File>
			<File
				RelativePath="..\heap.c">
			</File>
			<File
				RelativePath="..\html_gen.c">
			</File>
			<File
				RelativePath="..\istack.c">
			</File>
			<File
				RelativePath="..\list.c">
			</File>
			<File
				RelativePath="..\lru.c">
			</File>
			<File
				RelativePath="..\lru_hash.c">
			</File>
			<File
				RelativePath="..\report.c">
			</File>
			<File
				RelativePath="..\timestamp.c">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath="..\aqueue.h">
			</File>
			<File
				RelativePath="..\aqueue_inline.h">
			</File>
			<File
				RelativePath=".\config.h">
			</File>
			<File
				RelativePath="..\eqhash.h">
			</File>
			<File
				RelativePath="..\eqhash_inline.h">
			</File>
			<File
				RelativePath="..\heap.h">
			</File>
			<File
				RelativePath="..\html_gen.h">
			</File>
			<File
				RelativePath="..\istack.h">
			</File>
			<File
				RelativePath="..\istack_inline.h">
			</File>
			<File
				RelativePath="..\list.h">
			</File>
			<File
				RelativePath="..\list_inline.h">
			</File>
			<File
				RelativePath="..\lru.h">
			</File>
			<File
				RelativePath="..\lru_hash.h">
			</File>
			<File
				RelativePath="..\lru_hash_inline.h">
			</File>
			<File
				RelativePath="..\lru_inline.h">
			</File>
			<File
				RelativePath="..\pthrutil.h">
			</File>
			<File
				RelativePath="..\report.h">
			</File>
			<File
				RelativePath="..\timestamp.h">
			</File>
			<File
				RelativePath="..\trace.h">
			</File>
			<File
				RelativePath="..\trace_inline.h">
			</File>
		</Filter>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
