<?xml version="1.0"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="PluginTV"
	SccProjectName=""
	SccLocalPath="">
	<Build>
		<Settings>
			<Platform
				Name="Win32"/>
			<Configuration
				Name="Release|Win32"
				IntermediateDirectory=".\Release"
				OutputDirectory=".\Release"
				ConfigurationType="1"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE"
				CharacterSet="2">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Release/PluginTV.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					InlineFunctionExpansion="1"
					IncludePaths="$(pathtv),$(pathtv)/winbuild,$(pathtv)/tsm,$(pathtv)/tsm/winbuild,$(pathtv)/tsm/winbuild/tsm,$(pathtv)/bin/WIN954.0_DBG.OBJ/include,$(pathtv)/conversions,$(pathtv)/terravision"
					Defines="WIN32,NDEBUG,_WINDOWS,HAVE_CONFIG_H"
					StringPooling="TRUE"
					RuntimeLibrary="2"
					PackageFunctions="TRUE"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Release/PluginTV.pch"
					AsmListingLocation=".\Release/"
					ObjectFile=".\Release/"
					ProgramDataBaseFileName=".\Release/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLinkerTool"
					AdditionalOptions="/MACHINE:I386"
					AdditionalInputs="odbc32.lib odbccp32.lib opengl32.lib glu32.lib ws2_32.lib mswsock.lib winmm.lib &quot;$(pathtv)/bin/libtv2.lib&quot; &quot;$(pathtv)/bin/libtsm.lib&quot; &quot;$(pathtv)/bin/libghttp.lib&quot; &quot;$(pathtv)/bin/libpthr.lib&quot; &quot;$(pathtv)/bin/libjpg.lib&quot; &quot;$(pathtv)/bin/libtiff.lib&quot; &quot;$(pathtv)/bin/libungif.lib&quot; &quot;$(pathtv)/bin/libvrml2.lib&quot; &quot;$(pathtv)/bin/libglt.lib&quot; &quot;$(pathtv)/bin/tvutils.lib&quot; &quot;$(pathtv)/bin/libxml.lib&quot; &quot;$(pathtv)/bin/libconv.lib&quot; &quot;$(pathtv)/bin/libdis.lib&quot;"
					OutputFile=".\Release/PluginTV.exe"
					LinkIncremental="1"
					SuppressStartupMessage="TRUE"
					ProgramDatabaseFile=".\Release/PluginTV.pdb"
					SubSystem="2"/>
				<Tool
					Name="VCMIDLTool"
					Defines="NDEBUG"
					MkTypLibCompatibility="TRUE"
					SuppressStartupMessage="TRUE"
					TargetEnvironment="1"
					TypeLibraryName=".\Release/PluginTV.tlb"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="NDEBUG"
					Culture="1033"/>
				<Tool
					Name="VCSDLTool"/>
			</Configuration>
			<Configuration
				Name="Debug|Win32"
				IntermediateDirectory=".\Debug"
				OutputDirectory=".\Debug"
				ConfigurationType="1"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE"
				CharacterSet="2">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Debug/PluginTV.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					Optimization="0"
					IncludePaths="$(pathtv),$(pathtv)/winbuild,$(pathtv)/tsm,$(pathtv)/tsm/winbuild,$(pathtv)/tsm/winbuild/tsm,$(pathtv)/bin/WIN954.0_DBG.OBJ/include,$(pathtv)/conversions,$(pathtv)/terravision"
					Defines="WIN32,_DEBUG,_WINDOWS,HAVE_CONFIG_H,TRACING,_MSVC"
					RuntimeLibrary="3"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Debug/PluginTV.pch"
					AsmListingLocation=".\Debug/"
					ObjectFile=".\Debug/"
					ProgramDataBaseFileName=".\Debug/"
					BrowseInformation="1"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"
					DebugInformation="1"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLinkerTool"
					AdditionalOptions="/MACHINE:I386"
					AdditionalInputs="odbc32.lib odbccp32.lib opengl32.lib glu32.lib ws2_32.lib mswsock.lib winmm.lib &quot;$(pathtv)/bin/libtv2_d.lib&quot; &quot;$(pathtv)/bin/libtsm_d.lib&quot; &quot;$(pathtv)/bin/libghttp_d.lib&quot; &quot;$(pathtv)/bin/libpthr_d.lib&quot; &quot;$(pathtv)/bin/libjpg_d.lib&quot; &quot;$(pathtv)/bin/libtiff_d.lib&quot; &quot;$(pathtv)/bin/libungif_d.lib&quot; &quot;$(pathtv)/bin/libvrml2_d.lib&quot; &quot;$(pathtv)/bin/libglt_d.lib&quot; &quot;$(pathtv)/bin/tvutils_d.lib&quot; &quot;$(pathtv)/bin/libxml_d.lib&quot; &quot;$(pathtv)/bin/libconv_d.lib&quot; &quot;$(pathtv)/bin/libdis_d.lib&quot;"
					OutputFile="$(pathtv)/bin/PluginTV_d.exe"
					LinkIncremental="1"
					SuppressStartupMessage="TRUE"
					GenerateDebug="TRUE"
					ProgramDatabaseFile=".\Debug/PluginTV.pdb"
					SubSystem="2"/>
				<Tool
					Name="VCMIDLTool"
					Defines="_DEBUG"
					MkTypLibCompatibility="TRUE"
					SuppressStartupMessage="TRUE"
					TargetEnvironment="1"
					TypeLibraryName=".\Debug/PluginTV.tlb"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="_DEBUG"
					Culture="1033"/>
				<Tool
					Name="VCSDLTool"/>
			</Configuration>
		</Settings>
	</Build>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;rc;def;r;odl;idl;hpj;bat">
			<File
				RelativePath="..\glmTiming.c">
			</File>
			<File
				RelativePath="..\PathsFE.c">
			</File>
			<File
				RelativePath="..\Platform_win.c">
			</File>
			<File
				RelativePath="..\TerraVision.c">
			</File>
			<File
				RelativePath="..\..\TerraVision\ThreeDCore.c">
			</File>
			<File
				RelativePath="..\ThreeDWidget.c">
			</File>
			<File
				RelativePath="..\Viewpoint.c">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath="..\..\glt\glt_inline.h">
			</File>
			<File
				RelativePath="..\PathsFE.h">
			</File>
			<File
				RelativePath="..\Platform_win.h">
			</File>
			<File
				RelativePath="..\TerraVisionInc.h">
			</File>
			<File
				RelativePath="..\ThreeDWidget.h">
			</File>
			<File
				RelativePath="..\ThreeDWidgetI.h">
			</File>
			<File
				RelativePath="..\Viewpoint.h">
			</File>
		</Filter>
		<Filter
			Name="Resource Files"
			Filter="ico;cur;bmp;dlg;rc2;rct;bin;rgs;gif;jpg;jpeg;jpe">
		</Filter>
		<File
			RelativePath="..\ChangeLog">
		</File>
		<File
			RelativePath="..\..\bin\WIN954.0_DBG.OBJ\lib\nspr4.lib">
		</File>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
