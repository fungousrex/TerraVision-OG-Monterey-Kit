<?xml version="1.0"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="libvrml2"
	SccProjectName=""
	SccLocalPath="">
	<Build>
		<Settings>
			<Platform
				Name="Win32"/>
			<Configuration
				Name="Release|Win32"
				IntermediateDirectory=".\Release"
				OutputDirectory=".\Release"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE"
				CharacterSet="2">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Release/libvrml2.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					InlineFunctionExpansion="1"
					IncludePaths="$(pathtv),$(pathtv)/winbuild,$(pathtv)/bin/WIN954.0_DBG.OBJ/include,$(pathtv)/vrml2"
					Defines="WIN32,NDEBUG,_LIB,HAVE_CONFIG_H"
					StringPooling="TRUE"
					RuntimeLibrary="2"
					PackageFunctions="TRUE"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Release/libvrml2.pch"
					AsmListingLocation=".\Release/"
					ObjectFile=".\Release/"
					ProgramDataBaseFileName=".\Release/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\libvrml2.lib&quot;&quot; "
					OutputFile=".\Release\libvrml2.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="NDEBUG"
					Culture="1033"/>
			</Configuration>
			<Configuration
				Name="Debug|Win32"
				IntermediateDirectory=".\Debug"
				OutputDirectory=".\Debug"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Debug/libvrml2.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					Optimization="0"
					IncludePaths="$(pathtv),$(pathtv)/winbuild,$(pathtv)/bin/WIN954.0_DBG.OBJ/include,$(pathtv)/vrml2"
					Defines="WIN32,_DEBUG,_WINDOWS,HAVE_CONFIG_H"
					RuntimeLibrary="3"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Debug/libvrml2.pch"
					AsmListingLocation=".\Debug/"
					ObjectFile=".\Debug/"
					ProgramDataBaseFileName=".\Debug/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"
					DebugInformation="1"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\libvrml2_d.lib&quot;&quot; "
					OutputFile="$(pathtv)/bin/libvrml2_d.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="_DEBUG"
					Culture="1033"/>
			</Configuration>
		</Settings>
	</Build>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;rc;def;r;odl;idl;hpj;bat">
			<File
				RelativePath="..\bbox.c">
			</File>
			<File
				RelativePath="..\c_nodes.c">
			</File>
			<File
				RelativePath="..\c_print.c">
			</File>
			<File
				RelativePath="..\c_render.c">
			</File>
			<File
				RelativePath="..\c_utils.c">
			</File>
			<File
				RelativePath="..\decomp.c">
			</File>
			<File
				RelativePath="..\geom3.c">
			</File>
			<File
				RelativePath="..\invert.c">
			</File>
			<File
				RelativePath="..\lu.c">
			</File>
			<File
				RelativePath="..\newlex.c">
			</File>
			<File
				RelativePath="..\newparse.c">
			</File>
			<File
				RelativePath="..\plist.c">
			</File>
			<File
				RelativePath="..\quat.c">
			</File>
			<File
				RelativePath="..\symtab.c">
			</File>
			<File
				RelativePath="..\vec3.c">
			</File>
			<File
				RelativePath="..\vrml2defs.c">
			</File>
			<File
				RelativePath="..\vrml2stubs.c">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath="..\bbox.h">
			</File>
			<File
				RelativePath="..\c_nodes.h">
			</File>
			<File
				RelativePath=".\config.h">
			</File>
			<File
				RelativePath="..\geom3.h">
			</File>
			<File
				RelativePath="..\plist.h">
			</File>
			<File
				RelativePath="..\quat.h">
			</File>
			<File
				RelativePath="..\symtab.h">
			</File>
			<File
				RelativePath="..\vec3.h">
			</File>
			<File
				RelativePath="..\vrml2.h">
			</File>
			<File
				RelativePath="..\vrml2il.h">
			</File>
			<File
				RelativePath="..\vrml2int.h">
			</File>
		</Filter>
	</Files>
	<Globals>
