DEFNODE(Anchor)
 EVENTIN      (Anchor, MFNode,   addChildren)
 EVENTIN      (Anchor, MFNode,   removeChildren)

 EXPOSEDFIELD (Anchor, MFNode,   children,    MFNodeEmpty)
 EXPOSEDFIELD (Anchor, SFString, description, "")
 EXPOSEDFIELD (Anchor, MFString, parameter,   MFStringEmpty)
 EXPOSEDFIELD (Anchor, MFString, url,         MFStringEmpty)
 FIELD        (Anchor, SFVec3f,  bboxCenter,  SFVec3fZero)
 FIELD        (Anchor, SFVec3f,  bboxSize,    SFVec3fNeg1)
ENDNODE(Anchor)

DEFNODE(Appearance)
 EXPOSEDFIELD (Appearance, SFNode, material,         NULL)
 EXPOSEDFIELD (Appearance, SFNode, texture,          NULL)
 EXPOSEDFIELD (Appearance, SFNode, textureTransform, NULL)
ENDNODE(Appearance)

DEFNODE(AudioClip)
 EXPOSEDFIELD (AudioClip, SFString, description, "")
 EXPOSEDFIELD (AudioClip, SFBool,   loop,        FALSE)
 EXPOSEDFIELD (AudioClip, SFFloat,  pitch,       SFFloat1)
 EXPOSEDFIELD (AudioClip, SFTime,   startTime,   SFTime0)
 EXPOSEDFIELD (AudioClip, SFTime,   stopTime,    SFTime0)
 EXPOSEDFIELD (AudioClip, MFString, url,         MFStringEmpty)

 EVENTOUT     (AudioClip, SFTime,   duration)
 EVENTOUT     (AudioClip, SFBool,   isActive)
ENDNODE(AudioClip)

DEFNODE(Background)
 EVENTIN      (Background, SFBool,   bind)

 EXPOSEDFIELD (Background, MFFloat,  groundAngle, MFFloatEmpty)
 EXPOSEDFIELD (Background, MFColor,  groundColor, MFColorEmpty)
 EXPOSEDFIELD (Background, MFString, backUrl,     MFStringEmpty)
 EXPOSEDFIELD (Background, MFString, bottomUrl,   MFStringEmpty)
 EXPOSEDFIELD (Background, MFString, frontUrl,    MFStringEmpty)
 EXPOSEDFIELD (Background, MFString, leftUrl,     MFStringEmpty)
 EXPOSEDFIELD (Background, MFString, rightUrl,    MFStringEmpty)
 EXPOSEDFIELD (Background, MFString, topUrl,      MFStringEmpty)
 EXPOSEDFIELD (Background, MFFloat,  skyAngle,    MFFloatEmpty)
 EXPOSEDFIELD (Background, MFColor,  skyColor,    MFColorBlack)

 EVENTOUT     (Background, SFBool,     isBound)
ENDNODE(Background)

DEFNODE(Billboard)
 EVENTIN      (Billboard, MFNode,  addChildren)
 EVENTIN      (Billboard, MFNode,  removeChildren)

 EXPOSEDFIELD (Billboard, SFVec3f, axisOfRotation, SFVec3fYAxis)
 EXPOSEDFIELD (Billboard, MFNode,  children,       MFNodeEmpty)
 FIELD        (Billboard, SFVec3f, bboxCenter,     SFVec3fZero)
 FIELD        (Billboard, SFVec3f, bboxSize,       SFVec3fNeg1)
ENDNODE(Billboard)

DEFNODE(Box)
 FIELD        (Box, SFVec3f, size, SFVec3fTwo)
ENDNODE(Box)

DEFNODE(Collision)
 EVENTIN      (Collision, MFNode,  addChildren)
 EVENTIN      (Collision, MFNode,  removeChildren)

 EXPOSEDFIELD (Collision, MFNode,  children,   MFNodeEmpty)
 EXPOSEDFIELD (Collision, SFBool,  collide,    TRUE)
 FIELD        (Collision, SFVec3f, bboxCenter, SFVec3fZero)
 FIELD        (Collision, SFVec3f, bboxSize,   SFVec3fNeg1)
 FIELD        (Collision, SFNode,  proxy,      NULL)

 EVENTOUT     (Collision, SFTime,  collideTime)
ENDNODE(Collision)

DEFNODE(Color)
 EXPOSEDFIELD (Color, MFColor, color, MFColorEmpty)
ENDNODE(Color)

DEFNODE(ColorInterpolator)
 EVENTIN      (ColorInterpolator, SFFloat, fraction)

 EXPOSEDFIELD (ColorInterpolator, MFFloat, key,      MFFloatEmpty)
 EXPOSEDFIELD (ColorInterpolator, MFColor, keyValue, MFColorEmpty)

 EVENTOUT     (ColorInterpolator, SFColor, value)
ENDNODE(ColorInterpolator)

DEFNODE(Cone)
 FIELD (Cone, SFFloat, bottomRadius, SFFloat1)
 FIELD (Cone, SFFloat, height,       SFFloat2)
 FIELD (Cone, SFBool,  side,         TRUE)
 FIELD (Cone, SFBool,  bottom,       TRUE)
ENDNODE(Cone)

DEFNODE(Coordinate)
 EXPOSEDFIELD (Coordinate, MFVec3f, point, MFVec3fEmpty)
ENDNODE(Coordinate)

DEFNODE(CoordinateInterpolator)
 EVENTIN      (CoordinateInterpolator, SFFloat, fraction)

 EXPOSEDFIELD (CoordinateInterpolator, MFFloat, key,      MFFloatEmpty)
 EXPOSEDFIELD (CoordinateInterpolator, MFVec3f, keyValue, MFVec3fEmpty)

 EVENTOUT     (CoordinateInterpolator, MFVec3f, value)
ENDNODE(CoordinateInterpolator)

DEFNODE(Cylinder)
 FIELD (Cylinder, SFBool,  bottom, TRUE)
 FIELD (Cylinder, SFFloat, height, SFFloat2)
 FIELD (Cylinder, SFFloat, radius, SFFloat1)
 FIELD (Cylinder, SFBool,  side,   TRUE)
 FIELD (Cylinder, SFBool,  top,    TRUE)
ENDNODE(Cylinder)

DEFNODE(CylinderSensor)
 EXPOSEDFIELD (CylinderSensor, SFBool,  autoOffset, TRUE)
 EXPOSEDFIELD (CylinderSensor, SFFloat, diskAngle,  SFFloat0_262)
 EXPOSEDFIELD (CylinderSensor, SFBool,  enabled,    TRUE)
 EXPOSEDFIELD (CylinderSensor, SFFloat, maxAngle,   SFFloatNeg1)
 EXPOSEDFIELD (CylinderSensor, SFFloat, minAngle,   SFFloat0)
 EXPOSEDFIELD (CylinderSensor, SFFloat, offset,     SFFloat0)

 EVENTOUT     (CylinderSensor, SFBool,     isActive)
 EVENTOUT     (CylinderSensor, SFRotation, rotation)
 EVENTOUT     (CylinderSensor, SFVec3f,    trackPoint)
ENDNODE(CylinderSensor)

DEFNODE(DirectionalLight)
 EXPOSEDFIELD (DirectionalLight, SFFloat, ambientIntensity, SFFloat0)
 EXPOSEDFIELD (DirectionalLight, SFColor, color,            SFColorWhite)
 EXPOSEDFIELD (DirectionalLight, SFVec3f, direction,        SFVec3fDirDown)
 EXPOSEDFIELD (DirectionalLight, SFFloat, intensity,        SFFloat1)
 EXPOSEDFIELD (DirectionalLight, SFBool,  on,               TRUE)
ENDNODE(DirectionalLight)

DEFNODE(ElevationGrid)
 EVENTIN      (ElevationGrid, MFFloat, height)

 EXPOSEDFIELD (ElevationGrid, SFNode,  color,           NULL)
 EXPOSEDFIELD (ElevationGrid, SFNode,  normal,          NULL)
 EXPOSEDFIELD (ElevationGrid, SFNode,  texCoord,        NULL)
 FIELD        (ElevationGrid, MFFloat, height,          MFFloatEmpty)
 FIELD        (ElevationGrid, SFBool,  ccw,             TRUE)
 FIELD        (ElevationGrid, SFBool,  colorPerVertex,  TRUE)
 FIELD        (ElevationGrid, SFFloat, creaseAngle,     SFFloat0)
 FIELD        (ElevationGrid, SFBool,  normalPerVertex, TRUE)
 FIELD        (ElevationGrid, SFBool,  solid,           TRUE)
 FIELD        (ElevationGrid, SFInt32, xDimension,      0)
 FIELD        (ElevationGrid, SFFloat, xSpacing,        SFFloat1)
 FIELD        (ElevationGrid, SFInt32, zDimension,      0)
 FIELD        (ElevationGrid, SFFloat, zSpacing,        SFFloat1)
ENDNODE(ElevationGrid)

DEFNODE(Extrusion)
 EVENTIN (Extrusion, MFVec2f,    crossSection)
 EVENTIN (Extrusion, MFRotation, orientation)
 EVENTIN (Extrusion, MFVec2f,    scale)
 EVENTIN (Extrusion, MFVec3f,    spine)

 FIELD   (Extrusion, SFBool,     beginCap,     TRUE)
 FIELD   (Extrusion, SFBool,     ccw,          TRUE)
 FIELD   (Extrusion, SFBool,     convex,       TRUE)
 FIELD   (Extrusion, SFFloat,    creaseAngle,  SFFloat0)
 FIELD   (Extrusion, MFVec2f,    crossSection, MFVec2fCrossSection)
 FIELD   (Extrusion, SFBool,     endCap,       TRUE)
 FIELD   (Extrusion, MFRotation, orientation,  MFRotationZout)
 FIELD   (Extrusion, MFVec2f,    scale,        MFVec2fIdentity)
 FIELD   (Extrusion, SFBool,     solid,        TRUE)
 FIELD   (Extrusion, MFVec3f,    spine,        MFVec3fSpine)
ENDNODE(Extrusion)

DEFNODE(Fog)
 EVENTIN      (Fog, SFBool,   bind)

 EXPOSEDFIELD (Fog, SFColor,  color,           SFColorWhite)
 EXPOSEDFIELD (Fog, SFString, fogType,         "LINEAR")
 EXPOSEDFIELD (Fog, SFFloat,  visibilityRange, SFFloat0)

 EVENTOUT     (Fog, SFBool,   isBound)
ENDNODE(Fog)

DEFNODE(FontStyle)
 FIELD (FontStyle, MFString, family,      MFStringSERIF)
 FIELD (FontStyle, SFBool,   horizontal,  TRUE)
 FIELD (FontStyle, MFString, justify,     MFStringBEGIN)
 FIELD (FontStyle, SFString, language,    "")
 FIELD (FontStyle, SFBool,   leftToRight, TRUE)
 FIELD (FontStyle, SFFloat,  size,        SFFloat1)
 FIELD (FontStyle, SFFloat,  spacing,     SFFloat1)
 FIELD (FontStyle, SFString, style,       "PLAIN")
 FIELD (FontStyle, SFBool,   topToBottom, TRUE)
ENDNODE(FontStyle)

DEFNODE(Group)
 EVENTIN      (Group, MFNode,  addChildren)
 EVENTIN      (Group, MFNode,  removeChildren)

 EXPOSEDFIELD (Group, MFNode,  children,   MFNodeEmpty)
 FIELD        (Group, SFVec3f, bboxCenter, SFVec3fZero)
 FIELD        (Group, SFVec3f, bboxSize,   SFVec3fNeg1)
ENDNODE(Group)

DEFNODE(ImageTexture)
 EXPOSEDFIELD (ImageTexture, MFString, url,     MFStringEmpty)
 FIELD        (ImageTexture, SFBool,   repeatS, TRUE)
 FIELD        (ImageTexture, SFBool,   repeatT, TRUE)
ENDNODE(ImageTexture)

DEFNODE(IndexedFaceSet)
 EVENTIN      (IndexedFaceSet, MFInt32, colorIndex)
 EVENTIN      (IndexedFaceSet, MFInt32, coordIndex)
 EVENTIN      (IndexedFaceSet, MFInt32, normalIndex)
 EVENTIN      (IndexedFaceSet, MFInt32, texCoordIndex)

 EXPOSEDFIELD (IndexedFaceSet, SFNode,  color,           NULL)
 EXPOSEDFIELD (IndexedFaceSet, SFNode,  coord,           NULL)
 EXPOSEDFIELD (IndexedFaceSet, SFNode,  normal,          NULL)
 EXPOSEDFIELD (IndexedFaceSet, SFNode,  texCoord,        NULL)
 FIELD        (IndexedFaceSet, SFBool,  ccw,             TRUE)
 FIELD        (IndexedFaceSet, MFInt32, colorIndex,      MFInt32Empty)
 FIELD        (IndexedFaceSet, SFBool,  colorPerVertex,  TRUE)
 FIELD        (IndexedFaceSet, SFBool,  convex,          TRUE)
 FIELD        (IndexedFaceSet, MFInt32, coordIndex,      MFInt32Empty)
 FIELD        (IndexedFaceSet, SFFloat, creaseAngle,     SFFloat0)
 FIELD        (IndexedFaceSet, MFInt32, normalIndex,     MFInt32Empty)
 FIELD        (IndexedFaceSet, SFBool,  normalPerVertex, TRUE)
 FIELD        (IndexedFaceSet, SFBool,  solid,           TRUE)
 FIELD        (IndexedFaceSet, MFInt32, texCoordIndex,   MFInt32Empty)
ENDNODE(IndexedFaceSet)

DEFNODE(IndexedLineSet)
 EVENTIN      (IndexedLineSet, MFInt32, colorIndex)
 EVENTIN      (IndexedLineSet, MFInt32, coordIndex)

 EXPOSEDFIELD (IndexedLineSet, SFNode,  color,          NULL)
 EXPOSEDFIELD (IndexedLineSet, SFNode,  coord,          NULL)
 FIELD        (IndexedLineSet, MFInt32, colorIndex,     MFInt32Empty)
 FIELD        (IndexedLineSet, SFBool,  colorPerVertex, TRUE)
 FIELD        (IndexedLineSet, MFInt32, coordIndex,     MFInt32Empty)
ENDNODE(IndexedLineSet)

DEFNODE(Inline)
 EXPOSEDFIELD (Inline, MFString, url,        MFStringEmpty)
 FIELD        (Inline, SFVec3f,  bboxCenter, SFVec3fZero)
 FIELD        (Inline, SFVec3f,  bboxSize,   SFVec3fNeg1)
ENDNODE(Inline)

DEFNODE(LOD)
 EXPOSEDFIELD (LOD, MFNode,  level,  MFNodeEmpty)
 FIELD        (LOD, SFVec3f, center, SFVec3fZero)
 FIELD        (LOD, MFFloat, range,  MFFloatEmpty)
ENDNODE(LOD)

DEFNODE(Material)
 EXPOSEDFIELD (Material, SFFloat, ambientIntensity, SFFloat0)
 EXPOSEDFIELD (Material, SFColor, diffuseColor,     SFColorGray80)
 EXPOSEDFIELD (Material, SFColor, emissiveColor,    SFColorBlack)
 EXPOSEDFIELD (Material, SFFloat, shininess,        SFFloat0_2)
 EXPOSEDFIELD (Material, SFColor, specularColor,    SFColorBlack)
 EXPOSEDFIELD (Material, SFFloat, transparency,     SFFloat0)
ENDNODE(Material)

DEFNODE(MovieTexture)
 EXPOSEDFIELD (MovieTexture, SFBool,   loop,      FALSE)
 EXPOSEDFIELD (MovieTexture, SFFloat,  speed,     SFFloat1)
 EXPOSEDFIELD (MovieTexture, SFTime,   startTime, SFTime0)
 EXPOSEDFIELD (MovieTexture, SFTime,   stopTime,  SFTime0)
 EXPOSEDFIELD (MovieTexture, MFString, url,       MFStringEmpty)
 FIELD        (MovieTexture, SFBool,   repeatS,   TRUE)
 FIELD        (MovieTexture, SFBool,   repeatT,   TRUE)

 EVENTOUT     (MovieTexture, SFTime,   duration)
 EVENTOUT     (MovieTexture, SFBool,   isActive)
ENDNODE(MovieTexture)

DEFNODE(NavigationInfo)
 EVENTIN      (NavigationInfo, SFBool,   bind)

 EXPOSEDFIELD (NavigationInfo, MFFloat,  avatarSize,      MFFloatAvatar)
 EXPOSEDFIELD (NavigationInfo, SFBool,   headlight,       TRUE)
 EXPOSEDFIELD (NavigationInfo, SFFloat,  speed,           SFFloat1)
 EXPOSEDFIELD (NavigationInfo, MFString, type,            MFStringNavType)
 EXPOSEDFIELD (NavigationInfo, SFFloat,  visibilityLimit, SFFloat0)

 EVENTOUT     (NavigationInfo, SFBool,   isBound)
ENDNODE(NavigationInfo)

DEFNODE(Normal)
 EXPOSEDFIELD (Normal, MFVec3f, vector, MFVec3fEmpty)
ENDNODE(Normal)

DEFNODE(NormalInterpolator)
 EVENTIN      (NormalInterpolator, SFFloat, fraction)

 EXPOSEDFIELD (NormalInterpolator, MFFloat, key,      MFFloatEmpty)
 EXPOSEDFIELD (NormalInterpolator, MFVec3f, keyValue, MFVec3fEmpty)

 EVENTOUT     (NormalInterpolator, MFVec3f, value)
ENDNODE(NormalInterpolator)

DEFNODE(OrientationInterpolator)
 EVENTIN      (OrientationInterpolator, SFFloat, fraction)

 EXPOSEDFIELD (OrientationInterpolator, MFFloat,    key,      MFFloatEmpty)
 EXPOSEDFIELD (OrientationInterpolator, MFRotation, keyValue, MFRotationEmpty)

 EVENTOUT     (OrientationInterpolator, MFRotation, value)
ENDNODE(OrientationInterpolator)

DEFNODE(PixelTexture)
 EXPOSEDFIELD (PixelTexture, SFImage, image,   SFImageEmpty)
 FIELD        (PixelTexture, SFBool,  repeatS, TRUE)
 FIELD        (PixelTexture, SFBool,  repeatT, TRUE)
ENDNODE(PixelTexture)

DEFNODE(PlaneSensor)
 EXPOSEDFIELD (PlaneSensor, SFBool,  autoOffset,  TRUE)
 EXPOSEDFIELD (PlaneSensor, SFBool,  enabled,     TRUE)
 EXPOSEDFIELD (PlaneSensor, SFVec2f, maxPosition, SFVec2fNeg1)
 EXPOSEDFIELD (PlaneSensor, SFVec2f, minPosition, SFVec2fZero)
 EXPOSEDFIELD (PlaneSensor, SFVec3f, offset,      SFVec3fZero)

 EVENTOUT     (PlaneSensor, SFBool,  isActive)
 EVENTOUT     (PlaneSensor, SFVec3f, trackPoint)
 EVENTOUT     (PlaneSensor, SFVec3f, translation)
ENDNODE(PlaneSensor)

DEFNODE(PointLight)
 EXPOSEDFIELD (PointLight, SFFloat, ambientIntensity, SFFloat0)
 EXPOSEDFIELD (PointLight, SFVec3f, attenuation,      SFVec3fXAxis)
 EXPOSEDFIELD (PointLight, SFColor, color,            SFColorWhite)
 EXPOSEDFIELD (PointLight, SFFloat, intensity,        SFFloat1)
 EXPOSEDFIELD (PointLight, SFVec3f, location,         SFVec3fZero)
 EXPOSEDFIELD (PointLight, SFBool,  on,               TRUE)
 EXPOSEDFIELD (PointLight, SFFloat, radius,           SFFloat100)
ENDNODE(PointLight)

DEFNODE(PointSet)
 EXPOSEDFIELD (PointSet, SFNode, color, NULL)
 EXPOSEDFIELD (PointSet, SFNode, coord, NULL)
ENDNODE(PointSet)

DEFNODE(PositionInterpolator)
 EVENTIN      (PositionInterpolator, SFFloat, fraction)

 EXPOSEDFIELD (PositionInterpolator, MFFloat, key,      MFFloatEmpty)
 EXPOSEDFIELD (PositionInterpolator, MFVec3f, keyValue, MFVec3fEmpty)

 EVENTOUT     (PositionInterpolator, SFVec3f, value)
ENDNODE(PositionInterpolator)

DEFNODE(ProximitySensor)
 EXPOSEDFIELD (ProximitySensor, SFVec3f,    center,  SFVec3fZero)
 EXPOSEDFIELD (ProximitySensor, SFVec3f,    size,    SFVec3fZero)
 EXPOSEDFIELD (ProximitySensor, SFBool,     enabled, TRUE)

 EVENTOUT     (ProximitySensor, SFBool,     isActive)
 EVENTOUT     (ProximitySensor, SFVec3f,    position)
 EVENTOUT     (ProximitySensor, SFRotation, orientation)
 EVENTOUT     (ProximitySensor, SFTime,     enterTime)
 EVENTOUT     (ProximitySensor, SFTime,     exitTime)
ENDNODE(ProximitySensor)

DEFNODE(ScalarInterpolator)
 EVENTIN      (ScalarInterpolator, SFFloat, fraction)

 EXPOSEDFIELD (ScalarInterpolator, MFFloat, key,      MFFloatEmpty)
 EXPOSEDFIELD (ScalarInterpolator, MFFloat, keyValue, MFFloatEmpty)

 EVENTOUT     (ScalarInterpolator, SFFloat, value)
ENDNODE(ScalarInterpolator)

DEFNODE(Script)
 EXPOSEDFIELD (Script, MFString, url,          MFStringEmpty)
 FIELD        (Script, SFBool,   directOutput, FALSE)
 FIELD        (Script, SFBool,   mustEvaluate, FALSE)
ENDNODE(Script)

DEFNODE(Shape)
 EXPOSEDFIELD (Shape, SFNode, appearance, NULL)
 EXPOSEDFIELD (Shape, SFNode, geometry,   NULL)
ENDNODE(Shape)

DEFNODE(Sound)
 EXPOSEDFIELD (Sound, SFVec3f, direction,  SFVec3fZAxis)
 EXPOSEDFIELD (Sound, SFFloat, intensity,  SFFloat1)
 EXPOSEDFIELD (Sound, SFVec3f, location,   SFVec3fZero)
 EXPOSEDFIELD (Sound, SFFloat, maxBack,    SFFloat10)
 EXPOSEDFIELD (Sound, SFFloat, maxFront,   SFFloat10)
 EXPOSEDFIELD (Sound, SFFloat, minBack,    SFFloat1)
 EXPOSEDFIELD (Sound, SFFloat, minFront,   SFFloat1)
 EXPOSEDFIELD (Sound, SFFloat, priority,   SFFloat1)
 EXPOSEDFIELD (Sound, SFNode,  source,     NULL)
 FIELD        (Sound, SFBool,  spatialize, TRUE)
ENDNODE(Sound)

DEFNODE(Sphere)
 FIELD (Sphere, SFFloat,  radius, SFFloat1)
ENDNODE(Sphere)

DEFNODE(SphereSensor)
 EXPOSEDFIELD (SphereSensor, SFBool,     autoOffset, TRUE)
 EXPOSEDFIELD (SphereSensor, SFBool,     enabled,    TRUE)
 EXPOSEDFIELD (SphereSensor, SFRotation, offset,     SFRotationYAxis)

 EVENTOUT     (SphereSensor, SFBool,     isActive)
 EVENTOUT     (SphereSensor, SFRotation, rotation)
 EVENTOUT     (SphereSensor, SFVec3f,    trackPoint)
ENDNODE(SphereSensor)

DEFNODE(SpotLight)
 EXPOSEDFIELD (SpotLight, SFFloat, ambientIntensity, SFFloat0)
 EXPOSEDFIELD (SpotLight, SFVec3f, attenuation,      SFVec3fXAxis)
 EXPOSEDFIELD (SpotLight, SFFloat, beamWidth,        SFFloatPi_2)
 EXPOSEDFIELD (SpotLight, SFColor, color,            SFColorWhite)
 EXPOSEDFIELD (SpotLight, SFFloat, cutOffAngle,      SFFloatPi_4)
 EXPOSEDFIELD (SpotLight, SFVec3f, direction,        SFVec3fDirDown)
 EXPOSEDFIELD (SpotLight, SFFloat, intensity,        SFFloat1)
 EXPOSEDFIELD (SpotLight, SFVec3f, location,         SFVec3fZero)
 EXPOSEDFIELD (SpotLight, SFBool,  on,               TRUE)
 EXPOSEDFIELD (SpotLight, SFFloat, radius,           SFFloat100)
ENDNODE(SpotLight)

DEFNODE(Switch)
 EXPOSEDFIELD (Switch, MFNode,  choice,      MFNodeEmpty)
 EXPOSEDFIELD (Switch, SFInt32, whichChoice, -1)
ENDNODE(Switch)

DEFNODE(Text)
 EXPOSEDFIELD (Text, MFString, string,    MFStringEmpty)
 EXPOSEDFIELD (Text, SFNode,   fontStyle, NULL)
 EXPOSEDFIELD (Text, MFFloat,  length,    MFFloatEmpty)
 EXPOSEDFIELD (Text, SFFloat,  maxExtent, SFFloat0)
ENDNODE(Text)

DEFNODE(TextureCoordinate)
 EXPOSEDFIELD (TextureCoordinate, MFVec2f, point, MFVec2fEmpty)
ENDNODE(TextureCoordinate)

DEFNODE(TextureTransform)
 EXPOSEDFIELD (TextureTransform, SFVec2f, center,      SFVec2fZero)
 EXPOSEDFIELD (TextureTransform, SFFloat, rotation,    SFFloat0)
 EXPOSEDFIELD (TextureTransform, SFVec2f, scale,       SFVec2fOne)
 EXPOSEDFIELD (TextureTransform, SFVec2f, translation, SFVec2fZero)
ENDNODE(TextureTransform)

DEFNODE(TimeSensor)
 EXPOSEDFIELD (TimeSensor, SFTime , cycleInterval, SFTime1)
 EXPOSEDFIELD (TimeSensor, SFBool,  enabled,       TRUE)
 EXPOSEDFIELD (TimeSensor, SFBool,  loop,          FALSE)
 EXPOSEDFIELD (TimeSensor, SFTime,  startTime,     SFTime0)
 EXPOSEDFIELD (TimeSensor, SFTime,  stopTime,      SFTime0)

 EVENTOUT     (TimeSensor, SFTime,  cycleTime)
 EVENTOUT     (TimeSensor, SFFloat, fraction)
 EVENTOUT     (TimeSensor, SFBool,  isActive)
 EVENTOUT     (TimeSensor, SFTime,  time)
ENDNODE(TimeSensor)

DEFNODE(TouchSensor)
 EXPOSEDFIELD (TouchSensor, SFBool, enabled, TRUE)

 EVENTOUT     (TouchSensor, SFVec3f, hitNormal)
 EVENTOUT     (TouchSensor, SFVec3f, hitPoint)
 EVENTOUT     (TouchSensor, SFVec2f, hitTexCoord)
 EVENTOUT     (TouchSensor, SFBool,  isActive)
 EVENTOUT     (TouchSensor, SFBool,  isOver)
 EVENTOUT     (TouchSensor, SFTime,  touchTime)
ENDNODE(TouchSensor)

DEFNODE(Transform)
 EVENTIN      (Transform, MFNode,     addChildren)
 EVENTIN      (Transform, MFNode,     removeChildren)

 EXPOSEDFIELD (Transform, SFVec3f,    center,           SFVec3fZero)
 EXPOSEDFIELD (Transform, MFNode,     children,         MFNodeEmpty)
 EXPOSEDFIELD (Transform, SFRotation, rotation,         SFRotationZAxis)
 EXPOSEDFIELD (Transform, SFVec3f,    scale,            SFVec3fOne)
 EXPOSEDFIELD (Transform, SFRotation, scaleOrientation, SFRotationZAxis)
 EXPOSEDFIELD (Transform, SFVec3f,    translation,      SFVec3fZero)
 FIELD        (Transform, SFVec3f,    bboxCenter,       SFVec3fZero)
 FIELD        (Transform, SFVec3f,    bboxSize,         SFVec3fNeg1)
ENDNODE(Transform)

DEFNODE(Viewpoint)
 EVENTIN      (Viewpoint, SFBool,     bind)

 EXPOSEDFIELD (Viewpoint, SFFloat,    fieldOfView, SFFloatPi_4)
 EXPOSEDFIELD (Viewpoint, SFBool,     jump,        TRUE)
 EXPOSEDFIELD (Viewpoint, SFRotation, orientation, SFRotationZAxis)
 EXPOSEDFIELD (Viewpoint, SFVec3f,    position,    SFVec3fViewpos)
 FIELD        (Viewpoint, SFString,   description, "")

 EVENTOUT     (Viewpoint, SFTime,     bindTime)
 EVENTOUT     (Viewpoint, SFBool,     isBound)
ENDNODE(Viewpoint)

DEFNODE(VisibilitySensor)
 EXPOSEDFIELD (VisibilitySensor, SFVec3f, center,  SFVec3fZero)
 EXPOSEDFIELD (VisibilitySensor, SFBool,  enabled, TRUE)
 EXPOSEDFIELD (VisibilitySensor, SFVec3f, size,    SFVec3fZero)

 EVENTOUT     (VisibilitySensor, SFTime,  enterTime)
 EVENTOUT     (VisibilitySensor, SFTime,  exitTime)
 EVENTOUT     (VisibilitySensor, SFBool,  isActive)
