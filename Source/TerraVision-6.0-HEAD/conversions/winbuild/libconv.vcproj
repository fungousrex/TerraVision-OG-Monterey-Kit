<?xml version="1.0"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="libconv"
	SccProjectName=""
	SccLocalPath="">
	<Build>
		<Settings>
			<Platform
				Name="Win32"/>
			<Configuration
				Name="Debug|Win32"
				IntermediateDirectory=".\Debug"
				OutputDirectory=".\Debug"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Debug/libconv.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					Optimization="0"
					IncludePaths="$(pathtv)/winbuild"
					Defines="WIN32,_DEBUG,_WINDOWS,HAVE_CONFIG_H"
					RuntimeLibrary="3"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Debug/libconv.pch"
					AsmListingLocation=".\Debug/"
					ObjectFile=".\Debug/"
					ProgramDataBaseFileName=".\Debug/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"
					DebugInformation="1"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\libconv_d.lib&quot;&quot; "
					OutputFile="$(pathtv)/bin/libconv_d.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="_DEBUG"
					Culture="1033"/>
			</Configuration>
			<Configuration
				Name="Release|Win32"
				IntermediateDirectory=".\Release"
				OutputDirectory=".\Release"
				ConfigurationType="4"
				UseOfMFC="0"
				ATLMinimizesCRunTimeLibraryUsage="FALSE"
				CharacterSet="2">
				<Tool
					Name="VCBscMakeTool"
					SuppressStartupMessage="TRUE"
					OutputFile=".\Release/libconv.bsc"/>
				<Tool
					Name="VCCLCompilerTool"
					InlineFunctionExpansion="1"
					IncludePaths="$(pathtv)/winbuild"
					Defines="WIN32,NDEBUG,_LIB,HAVE_CONFIG_H"
					StringPooling="TRUE"
					RuntimeLibrary="2"
					PackageFunctions="TRUE"
					UsePrecompiledHeader="2"
					PrecompiledHeaderFile=".\Release/libconv.pch"
					AsmListingLocation=".\Release/"
					ObjectFile=".\Release/"
					ProgramDataBaseFileName=".\Release/"
					WarnLevel="3"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCCustomBuildTool"/>
				<Tool
					Name="VCLibrarianTool"
					AdditionalOptions="/out:&quot;&quot;$(pathtv)\bin\libconv.lib&quot;&quot; "
					OutputFile=".\Release\libconv.lib"
					SuppressStartupMessage="TRUE"/>
				<Tool
					Name="VCMIDLTool"/>
				<Tool
					Name="VCPostBuildEventTool"/>
				<Tool
					Name="VCPreBuildEventTool"/>
				<Tool
					Name="VCPreLinkEventTool"/>
				<Tool
					Name="VCResourceCompilerTool"
					Defines="NDEBUG"
					Culture="1033"/>
			</Configuration>
		</Settings>
	</Build>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;rc;def;r;odl;idl;hpj;bat">
			<File
				RelativePath="..\se_conv.c">
			</File>
			<File
				RelativePath="..\se_conv_default.c">
			</File>
			<File
				RelativePath="..\se_conv_io.c">
			</File>
			<File
				RelativePath="..\se_conv_print.c">
			</File>
			<File
				RelativePath="..\se_conv_util.c">
			</File>
			<File
				RelativePath="..\se_conv_valid.c">
			</File>
			<File
				RelativePath="..\se_coord_conv.c">
			</File>
			<File
				RelativePath="..\se_datums.c">
			</File>
			<File
				RelativePath="..\se_stds.c">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath="..\se_conv.h">
			</File>
			<File
				RelativePath="..\se_conv_default.h">
			</File>
			<File
				RelativePath="..\se_conv_io.h">
			</File>
			<File
				RelativePath="..\se_conv_print.h">
			</File>
			<File
				RelativePath="..\se_conv_types.h">
			</File>
			<File
				RelativePath="..\se_conv_util.h">
			</File>
			<File
				RelativePath="..\se_conv_valid.h">
			</File>
			<File
				RelativePath="..\se_datums.h">
			</File>
			<File
				RelativePath="..\se_stds.h">
			</File>
		</Filter>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
