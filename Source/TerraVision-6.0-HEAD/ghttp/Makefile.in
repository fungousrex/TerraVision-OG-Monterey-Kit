clean-libtool:
	-rm -rf .libs _libs

distclean-libtool:

maintainer-clean-libtool:

libghttp.la: $(libghttp_la_OBJECTS) $(libghttp_la_DEPENDENCIES)
	$(LINK) -rpath $(libdir) $(libghttp_la_LDFLAGS) $(libghttp_la_OBJECTS) $(libghttp_la_LIBADD) $(LIBS)

test_parser$(EXEEXT): $(test_parser_OBJECTS) $(test_parser_DEPENDENCIES)
	@rm -f test_parser$(EXEEXT)
	$(LINK) $(test_parser_LDFLAGS) $(test_parser_OBJECTS) $(test_parser_LDADD) $(LIBS)

test_proxy$(EXEEXT): $(test_proxy_OBJECTS) $(test_proxy_DEPENDENCIES)
	@rm -f test_proxy$(EXEEXT)
	$(LINK) $(test_proxy_LDFLAGS) $(test_proxy_OBJECTS) $(test_proxy_LDADD) $(LIBS)

test_client$(EXEEXT): $(test_client_OBJECTS) $(test_client_DEPENDENCIES)
