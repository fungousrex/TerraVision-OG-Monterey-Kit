			</File>
			<File
				RelativePath=".\xml-error.h">
			</File>
			<File
				RelativePath="..\xmlIO.h">
			</File>
			<File
				RelativePath="..\xmlmemory.h">
			</File>
			<File
				RelativePath="libxml\xmlversion.h">
			</File>
