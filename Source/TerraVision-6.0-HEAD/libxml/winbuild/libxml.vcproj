			</File>
			<File
				RelativePath="..\parserInternals.c">
			</File>
			<File
				RelativePath="..\SAX.c">
			</File>
			<File
				RelativePath="..\tree.c">
			</File>
			<File
				RelativePath="..\uri.c">
			</File>
			<File
