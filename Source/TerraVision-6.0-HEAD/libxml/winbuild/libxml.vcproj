			</File>
			<File
				RelativePath="..\xpath.c">
			</File>
			<File
				RelativePath="..\xpointer.c">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath="..\debugXML.h">
			</File>
			<File
				RelativePath="..\encoding.h">
			</File>
			<File
				RelativePath="..\entities.h">
			</File>
			<File
				RelativePath="..\hash.h">
			</File>
			<File
				RelativePath="..\HTMLparser.h">
			</File>
			<File
				RelativePath="..\HTMLtree.h">
			</File>
			<File
				RelativePath="..\nanoftp.h">
			</File>
			<File
				RelativePath="..\nanohttp.h">
			</File>
			<File
				RelativePath="..\parser.h">
			</File>
			<File
				RelativePath="..\parserInternals.h">
			</File>
			<File
				RelativePath="..\SAX.h">
			</File>
			<File
				RelativePath="..\tree.h">
			</File>
			<File
